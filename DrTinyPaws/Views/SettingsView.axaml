<UserControl
          x:Class="DrTinyPaws.Views.SettingsView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:vm="using:DrTinyPaws.ViewModels"
          d:DesignHeight="520"
          d:DesignWidth="520"
          x:DataType="vm:SettingsViewModel"
          mc:Ignorable="d">

    <Border
              Width="520"
              MaxHeight="520"
              Padding="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BorderThickness="1"
              CornerRadius="12">
        <StackPanel Spacing="20">
            <TextBlock
                      FontSize="20"
                      FontWeight="Bold"
                      Text="Settings &amp; Data Sync" />
            <TextBlock Text="DrTinyPaws stores your medication data in a local SQLite database that is fully compatible with Syncthing, Nextcloud, Google Drive, or OneDrive desktop sync clients." TextWrapping="Wrap" />

            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Current Active Database File:" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                              Margin="0,0,10,0"
                              Text="{Binding CustomPathInput}"
                              TextWrapping="Wrap" />
                    <Button
                              Grid.Column="1"
                              Padding="10,6"
                              BorderThickness="1"
                              Command="{Binding ResetToDefaultPathCommand}"
                              Content="Browse"
                              CornerRadius="6" />
                </Grid>

            </StackPanel>

            <Border
                      Padding="10"
                      BorderBrush="Gray"
                      BorderThickness="1"
                      CornerRadius="6">
                <StackPanel Spacing="15">
                    <TextBlock
                              FontSize="16"
                              FontWeight="Bold"
                              Text="How multi-device sync works:" />
                    <TextBlock Text="1. Point DrTinyPaws on this computer and your other devices to a shared sync directory (e.g. your Syncthing or Nextcloud folder)." TextWrapping="Wrap" />
                    <TextBlock Text="2. DrTinyPaws monitors the database file with automatic change detection. When another device syncs updates, the UI reloads instantly!" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock
                      FontWeight="SemiBold"
                      IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Text="{Binding StatusMessage}" />

            <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto">
                <Button
                          Grid.Column="0"
                          Padding="10,6"
                          BorderThickness="1"
                          Command="{Binding ResetToDefaultPathCommand}"
                          Content="Reset to Default Path"
                          CornerRadius="6" />
                <Button
                          Grid.Column="1"
                          Margin="0,0,8,0"
                          Padding="14,8"
                          Command="{Binding CancelCommand}"
                          Content="Close"
                          CornerRadius="6" />
                <Button
                          Grid.Column="2"
                          Padding="16,8"
                          Command="{Binding SavePathCommand}"
                          Content="Save Path"
                          CornerRadius="6"
                          FontWeight="Bold" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

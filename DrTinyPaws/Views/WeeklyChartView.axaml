<UserControl
          x:Class="DrTinyPaws.Views.WeeklyChartView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:vm="using:DrTinyPaws.ViewModels"
          d:DesignHeight="220"
          d:DesignWidth="800"
          x:DataType="vm:WeeklyChartViewModel"
          mc:Ignorable="d">

    <Border
              Padding="12,10,12,8"
              Background="{DynamicResource MaterialPaperBrush}"
              BorderBrush="{DynamicResource MaterialDividerBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
            <!--  Week Navigation Toolbar  -->
            <Grid
                      Grid.Row="0"
                      Margin="0,0,0,6"
                      ColumnDefinitions="Auto,*,Auto">
                <Button
                          Grid.Column="0"
                          Padding="8,4"
                          Command="{Binding PreviousWeekCommand}"
                          FontSize="{StaticResource NormalTextFontSize}"
                          FontWeight="SemiBold"
                          ToolTip.Tip="Previous Week">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"
                                  Kind="ChevronLeft" />
                        <TextBlock VerticalAlignment="Center" Text="Prev" />
                    </StackPanel>
                </Button>
                <!--  Current Week Range Label  -->
                <StackPanel
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Orientation="Horizontal"
                          Spacing="8">
                    <TextBlock
                              VerticalAlignment="Center"
                              FontSize="{StaticResource BodyTextFontSize}"
                              Text="Week of" />
                    <TextBlock
                              VerticalAlignment="Center"
                              FontSize="{StaticResource MediumTextFontSize}"
                              FontWeight="Bold"
                              Text="{Binding WeekLabel}" />
                </StackPanel>

                <Button
                          Grid.Column="2"
                          Padding="8,4"
                          Command="{Binding NextWeekCommand}"
                          FontSize="{StaticResource NormalTextFontSize}"
                          FontWeight="SemiBold"
                          ToolTip.Tip="Next Week">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock VerticalAlignment="Center" Text="Next" />
                        <materialIcons:MaterialIcon
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"
                                  Kind="ChevronRight" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  7-Day Stacked Column Chart  -->
            <lvc:CartesianChart
                      Grid.Row="1"
                      Height="165"
                      MinHeight="140"
                      LegendPosition="Hidden"
                      Series="{Binding Series}"
                      XAxes="{Binding XAxes}"
                      YAxes="{Binding YAxes}" />
        </Grid>
    </Border>
</UserControl>

<ContentPage
          x:Class="DrTinyPaws.Views.DashboardView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:models="using:DrTinyPaws.Models"
          xmlns:views="using:DrTinyPaws.Views"
          xmlns:vm="using:DrTinyPaws.ViewModels"
          Header="Dashboard"
          d:DesignHeight="700"
          d:DesignWidth="950"
          x:DataType="vm:DashboardViewModel"
          mc:Ignorable="d">

    <Grid>
        <Grid Margin="16,12,16,12" RowDefinitions="Auto,Auto,Auto,*">
        <!--  App Bar / Top Navigation  -->
        <Grid
                  Grid.Row="0"
                  Margin="0,0,0,10"
                  ColumnDefinitions="Auto,*,Auto">
            <!--  Primary Action Button  -->
            <StackPanel
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
                <Button
                          Padding="14,8"
                          Command="{Binding OpenTakeMedicationCommand}"
                          CornerRadius="6"
                          FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                                  FontSize="{StaticResource MediumTextFontSize}"
                                  FontWeight="Bold"
                                  Text="+" />
                        <TextBlock Text="Log Intake" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  In-App Notification / Reminder Banner  -->
        <Border
                  Grid.Row="1"
                  Margin="0,0,0,10"
                  Padding="12,8"
                  BorderThickness="1"
                  CornerRadius="6"
                  IsVisible="{Binding ShowNotificationBanner}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          FontSize="{StaticResource MediumTextFontSize}"
                          Text="🔔 " />
                <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Text="{Binding NotificationBanner}" />
                <Button
                          Grid.Column="2"
                          Padding="6,2"
                          BorderThickness="0"
                          Command="{Binding DismissNotificationBannerCommand}"
                          Content="✕" />
            </Grid>
        </Border>

        <!--  1/3rd Vertical Real Estate: 7-Day Stacked Bar Graph (~200px)  -->
        <Grid
                  Grid.Row="2"
                  Height="210"
                  Margin="0,0,0,12">
            <views:WeeklyChartView DataContext="{Binding ChartViewModel}" />
        </Grid>

        <!--  Bottom 2/3rds: Intakes Feed & Quick Presets  -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">

            <!--  Quick Presets Ribbon & Stats Header  -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <!--  Quick Presets  -->
                    <StackPanel
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Orientation="Horizontal"
                              Spacing="6">
                        <TextBlock
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"
                                  FontSize="{StaticResource NormalTextFontSize}"
                                  FontWeight="SemiBold"
                                  Text="Quick Presets:" />
                        <ItemsControl ItemsSource="{Binding DoseGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DoseGroup">
                                    <Button
                                              Padding="10,4"
                                              Command="{Binding $parent[ContentPage].((vm:DashboardViewModel)DataContext).QuickTakeGroupCommand}"
                                              CommandParameter="{Binding}"
                                              CornerRadius="14"
                                              ToolTip.Tip="Log this group now at configured quantities">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                      FontSize="{StaticResource NormalTextFontSize}"
                                                      FontWeight="SemiBold"
                                                      Text="{Binding Name}" />
                                            <TextBlock FontSize="{StaticResource ExtraSmallTextFontSize}" Text="⚡" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  Scrolling List of Intakes (Most recent at top)  -->
            <Border
                      Grid.Row="1"
                      Padding="12,8,12,0"
                      BorderThickness="1"
                      CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid
                              Grid.Row="0"
                              Margin="4,4,4,8"
                              ColumnDefinitions="*,Auto">
                        <TextBlock
                                  Grid.Column="0"
                                  FontSize="{StaticResource BodyTextFontSize}"
                                  FontWeight="Bold"
                                  Text="Intake History (Most Recent First)" />
                        <TextBlock
                                  Grid.Column="1"
                                  FontSize="{StaticResource SmallTextFontSize}"
                                  Text="{Binding RecentIntakes.Count, StringFormat='Showing {0} records'}" />
                    </Grid>

                    <!--  Empty State Notice  -->
                    <StackPanel
                              Grid.Row="1"
                              Margin="0,40,0,40"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !RecentIntakes.Count}"
                              Spacing="10">
                        <TextBlock
                                  HorizontalAlignment="Center"
                                  FontSize="{StaticResource DisplayFontSize}"
                                  Text="📋" />
                        <TextBlock
                                  HorizontalAlignment="Center"
                                  FontSize="{StaticResource MediumTextFontSize}"
                                  FontWeight="SemiBold"
                                  Text="No medication intakes recorded yet." />
                        <Button
                                  Padding="14,6"
                                  HorizontalAlignment="Center"
                                  Command="{Binding OpenTakeMedicationCommand}"
                                  Content="+ Record First Intake"
                                  CornerRadius="6" />
                    </StackPanel>

                    <!--  Scrollable Intake Feed  -->
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding RecentIntakes.Count}">
                        <ItemsControl ItemsSource="{Binding RecentIntakes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MedicationIntake">
                                    <Border
                                              Margin="0,0,0,6"
                                              Padding="0,10"
                                              BorderThickness="1"
                                              CornerRadius="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                            <!--  Medication Color Indicator  -->
                                            <Border
                                                      Grid.Column="0"
                                                      Width="50"
                                                      Height="50"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Top"
                                                      Background="{Binding MedicationColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                      CornerRadius="25">
                                                <TextBlock
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          FontSize="{StaticResource HeaderFontSize}"
                                                          FontWeight="Bold"
                                                          Text="{Binding Quantity}" />

                                            </Border>

                                            <!--  Medication Name & Dosage & Notes  -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <StackPanel Orientation="Vertical" Spacing="8">
                                                    <TextBlock
                                                              FontSize="{StaticResource MediumTextFontSize}"
                                                              FontWeight="Bold"
                                                              Text="{Binding MedicationName}" />

                                                    <TextBlock
                                                              FontSize="{StaticResource SmallTextFontSize}"
                                                              IsVisible="{Binding MedicationDosage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                              Text="{Binding MedicationDosage}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel
                                                      Grid.Column="2"
                                                      Margin="0,0,16,0"
                                                      VerticalAlignment="Center"
                                                      Orientation="Horizontal"
                                                      Spacing="16">

                                                <!--  Timestamp  -->
                                                <TextBlock
                                                          MinWidth="130"
                                                          VerticalAlignment="Center"
                                                          FontSize="{StaticResource NormalTextFontSize}"
                                                          Text="{Binding TakenAt, Converter={StaticResource DateTimeFormatConverter}}"
                                                          TextAlignment="Right" />
                                            </StackPanel>

                                            <!--  Delete button  -->
                                            <Button
                                                      Grid.Column="3"
                                                      Padding="6,4"
                                                      BorderThickness="0"
                                                      Command="{Binding $parent[ContentPage].((vm:DashboardViewModel)DataContext).DeleteIntakeCommand}"
                                                      CommandParameter="{Binding}"
                                                      ToolTip.Tip="Delete this intake entry">
                                                ✕
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>

        <!--  Floating Action Button (Quick Add)  -->
        <Border
                  Margin="0,0,24,24"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  BoxShadow="0 4 12 0 #50000000"
                  CornerRadius="28">
            <Button
                      x:Name="QuickAddFabButton"
                      Width="56"
                      Height="56"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Classes="accent fab"
                      CornerRadius="28"
                      ToolTip.Tip="Quick Add">
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                        <Border
                                  MinWidth="220"
                                  Padding="8"
                                  Background="{DynamicResource SystemRegionBrush}"
                                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock
                                          Margin="8,4,8,6"
                                          FontSize="{StaticResource NormalTextFontSize}"
                                          FontWeight="Bold"
                                          Opacity="0.7"
                                          Text="Quick Add" />
                                <ItemsControl ItemsSource="{Binding LastAddedMedications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Medication">
                                            <Button
                                                      Padding="10,8"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Left"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Click="OnQuickAddMenuItemClicked"
                                                      Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).QuickAddMedicationCommand}"
                                                      CommandParameter="{Binding}"
                                                      CornerRadius="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Ellipse
                                                              Grid.Column="0"
                                                              Width="12"
                                                              Height="12"
                                                              Margin="0,0,10,0"
                                                              VerticalAlignment="Center"
                                                              Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                    <TextBlock
                                                              Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              FontSize="{StaticResource MediumTextFontSize}"
                                                              FontWeight="SemiBold"
                                                              Text="{Binding Name}" />
                                                    <TextBlock
                                                              Grid.Column="2"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              FontSize="{StaticResource SmallTextFontSize}"
                                                              IsVisible="{Binding Dosage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                              Opacity="0.7"
                                                              Text="{Binding Dosage}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                          Margin="8,4"
                                          FontStyle="Italic"
                                          IsVisible="{Binding !LastAddedMedications.Count}"
                                          Opacity="0.5"
                                          Text="No medications yet" />
                                <Separator Margin="0,4" />
                                <Button
                                          Padding="10,8"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Click="OnQuickAddMenuItemClicked"
                                          Command="{Binding QuickAddOtherCommand}"
                                          CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                                  VerticalAlignment="Center"
                                                  FontSize="{StaticResource MediumTextFontSize}"
                                                  Text="➕" />
                                        <TextBlock
                                                  VerticalAlignment="Center"
                                                  FontSize="{StaticResource MediumTextFontSize}"
                                                  FontWeight="SemiBold"
                                                  Text="Other" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <TextBlock
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0,-2,0,0"
                          FontSize="28"
                          FontWeight="Normal"
                          Text="+" />
            </Button>
        </Border>
    </Grid>
</ContentPage>

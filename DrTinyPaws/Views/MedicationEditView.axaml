<ContentPage
          x:Class="DrTinyPaws.Views.MedicationEditView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:vm="using:DrTinyPaws.ViewModels"
          d:DesignHeight="700"
          d:DesignWidth="680"
          x:DataType="vm:MedicationEditViewModel"
          Header="Medication Details"
          mc:Ignorable="d">

    <ScrollViewer Margin="16,12">

        <StackPanel Spacing="12">
            <!--  Header  -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontSize="{StaticResource HeaderFontSize}"
                          FontWeight="Bold"
                          IsVisible="{Binding !IsEditing}"
                          Text="Define Medication" />
                <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontSize="{StaticResource HeaderFontSize}"
                          FontWeight="Bold"
                          IsVisible="{Binding IsEditing}"
                          Text="Edit Medication" />
            </Grid>

            <!--  Name  -->
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Medication Name *" />
                <TextBox PlaceholderText="e.g. Panadeine, Amoxicillin" Text="{Binding Name}" />
            </StackPanel>

            <!--  Dosage (Optional)  -->
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Dosage (optional)" />
                <TextBox PlaceholderText="e.g. 500mg, 10ml, 1 tablet" Text="{Binding Dosage}" />
            </StackPanel>

            <!--  Colour Selection  -->
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Color Identifier *" />
                <ItemsControl ItemsSource="{Binding AvailableColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button
                                      Margin="3"
                                      Padding="2"
                                      BorderThickness="0"
                                      Command="{Binding $parent[ContentPage].((vm:MedicationEditViewModel)DataContext).SelectColorCommand}"
                                      CommandParameter="{Binding}">
                                <Border
                                          Width="28"
                                          Height="28"
                                          Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                          BorderThickness="1"
                                          CornerRadius="14" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--  Custom Hex preview  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Selected:" />
                    <Border
                              Width="20"
                              Height="20"
                              Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                              CornerRadius="4" />
                    <TextBox Width="100" Text="{Binding ColorHex}" />
                </StackPanel>
            </StackPanel>

            <!--  Schedule (Optional)  -->
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Schedule (optional)" />
                <ComboBox
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CommonSchedules}"
                          SelectedItem="{Binding Schedule}" />
            </StackPanel>

            <!--  Reminder Time (Optional)  -->
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Reminder Time (optional, format HH:mm)" />
                <TextBox PlaceholderText="e.g. 08:00 or 20:30" Text="{Binding ReminderTime}" />
            </StackPanel>

            <!--  Notes  -->
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Instructions / Notes (optional)" />
                <TextBox PlaceholderText="e.g. Take with food" Text="{Binding Notes}" />
            </StackPanel>

            <!--  Error message  -->
            <TextBlock IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding ErrorMessage}" />

            <!--  Action buttons  -->
            <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto">
                <Button
                          Grid.Column="1"
                          Margin="0,0,8,0"
                          Padding="16,8"
                          Command="{Binding CancelCommand}"
                          CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center" Kind="Close" />
                        <TextBlock VerticalAlignment="Center" Text="Cancel" />
                    </StackPanel>
                </Button>
                <Button
                          Grid.Column="2"
                          Padding="16,8"
                          Command="{Binding SaveCommand}"
                          CornerRadius="6"
                          FontWeight="Bold"
                          IsVisible="{Binding !IsEditing}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center" Kind="ContentSaveOutline" />
                        <TextBlock VerticalAlignment="Center" Text="Save Medication" />
                    </StackPanel>
                </Button>
                <Button
                          Grid.Column="2"
                          Padding="16,8"
                          Command="{Binding SaveCommand}"
                          CornerRadius="6"
                          FontWeight="Bold"
                          IsVisible="{Binding IsEditing}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center" Kind="ContentSaveOutline" />
                        <TextBlock VerticalAlignment="Center" Text="Update Medication" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentPage>

<DrawerPage
          x:Class="DrTinyPaws.Views.MainView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:rxui="http://reactiveui.net"
          xmlns:views="using:DrTinyPaws.Views"
          xmlns:vm="using:DrTinyPaws.ViewModels"
          d:DesignHeight="700"
          d:DesignWidth="950"
          x:DataType="vm:MainViewModel"
          DrawerBackground="{DynamicResource MaterialPaperBrush}"
          DrawerBehavior="Flyout"
          DrawerLength="270"
          DrawerPlacement="Left"
          IsOpen="{Binding IsDrawerOpen, Mode=TwoWay}"
          TopLevel.AutoSafeAreaPadding="True"
          mc:Ignorable="d">

    <!--  Slide-out Navigation Drawer  -->
    <DrawerPage.Drawer>
        <Border
                  Padding="16,0,16,16"
                  Background="{DynamicResource MaterialPaperBrush}"
                  BorderBrush="{DynamicResource MaterialDividerBrush}"
                  BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!--  Drawer Header / App Branding  -->
                <StackPanel
                          Grid.Row="0"
                          Margin="0,0,0,20"
                          Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <materialIcons:MaterialIcon
                                  Width="26"
                                  Height="26"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"
                                  Kind="Pill" />
                        <TextBlock
                                  VerticalAlignment="Center"
                                  FontSize="{StaticResource HeaderFontSize}"
                                  FontWeight="Bold"
                                  Text="DrTinyPaws" />
                    </StackPanel>
                    <TextBlock
                              FontSize="{StaticResource SmallTextFontSize}"
                              Opacity="0.7"
                              Text="Medication Intake Tracker" />
                    <Separator Margin="0,12,0,0" />
                </StackPanel>

                <!--  Navigation Menu Items  -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="6">
                        <!--  Dashboard  -->
                        <Button
                                  Padding="12,10"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="flat"
                                  Command="{Binding NavigateToDashboardCommand}"
                                  CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <materialIcons:MaterialIcon
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Kind="ViewDashboard" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          FontSize="{StaticResource MediumTextFontSize}"
                                          FontWeight="SemiBold"
                                          Text="Dashboard" />
                            </StackPanel>
                        </Button>

                        <!--  Log Intake  -->
                        <Button
                                  Padding="12,10"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="flat"
                                  Command="{Binding NavigateToTakeMedicationCommand}"
                                  CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <materialIcons:MaterialIcon
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Kind="PlusCircleOutline" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          FontSize="{StaticResource MediumTextFontSize}"
                                          FontWeight="SemiBold"
                                          Text="Log Intake" />
                            </StackPanel>
                        </Button>

                        <!--  Medications  -->
                        <Button
                                  Padding="12,10"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="flat"
                                  Command="{Binding NavigateToMedicationsCommand}"
                                  CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <materialIcons:MaterialIcon
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Kind="PillMultiple" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          FontSize="{StaticResource MediumTextFontSize}"
                                          FontWeight="SemiBold"
                                          Text="Medications" />
                            </StackPanel>
                        </Button>

                        <!--  Group Presets  -->
                        <Button
                                  Padding="12,10"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="flat"
                                  Command="{Binding NavigateToGroupPresetsCommand}"
                                  CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <materialIcons:MaterialIcon
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Kind="FolderMultipleOutline" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          FontSize="{StaticResource MediumTextFontSize}"
                                          FontWeight="SemiBold"
                                          Text="Group Presets" />
                            </StackPanel>
                        </Button>

                        <!--  Settings  -->
                        <Button
                                  Padding="12,10"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="flat"
                                  Command="{Binding NavigateToSettingsCommand}"
                                  CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <materialIcons:MaterialIcon
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Kind="CogOutline" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          FontSize="{StaticResource MediumTextFontSize}"
                                          FontWeight="SemiBold"
                                          Text="Settings &amp; Sync" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </DrawerPage.Drawer>

    <!--  Main Content Area  -->
    <NavigationPage x:Name="NavPage">
        <views:DashboardView DataContext="{Binding $parent[DrawerPage].((vm:MainViewModel)DataContext).Dashboard}" />
    </NavigationPage>
</DrawerPage>

<ContentPage
          x:Class="DrTinyPaws.Views.MedicationManagementView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:models="using:DrTinyPaws.Models"
          xmlns:vm="using:DrTinyPaws.ViewModels"
          d:DesignHeight="600"
          d:DesignWidth="680"
          x:DataType="vm:MedicationManagementViewModel"
          Header="Medications"
          mc:Ignorable="d">

    <ScrollViewer Margin="16,12">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid
                      Grid.Row="0"
                      Margin="0,0,0,14"
                      ColumnDefinitions="Auto,*,Auto">
                <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontSize="{StaticResource HeaderFontSize}"
                          FontWeight="Bold"
                          Text="Manage Medications" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Medications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Medication">
                            <Border
                                      Margin="0,0,0,8"
                                      Padding="12,8"
                                      Background="{DynamicResource MaterialPaperBrush}"
                                      BorderBrush="{DynamicResource MaterialDividerBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border
                                              Grid.Column="0"
                                              Width="14"
                                              Height="14"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                              CornerRadius="7" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                      FontSize="{StaticResource MediumTextFontSize}"
                                                      FontWeight="Bold"
                                                      Text="{Binding Name}" />
                                            <Border
                                                      Padding="6,1"
                                                      VerticalAlignment="Center"
                                                      Background="{DynamicResource MaterialDividerBrush}"
                                                      CornerRadius="4"
                                                      IsVisible="{Binding Dosage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock FontSize="{StaticResource SmallTextFontSize}" Text="{Binding Dosage}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel
                                                  Margin="0,2,0,0"
                                                  Orientation="Horizontal"
                                                  Spacing="10">
                                            <TextBlock
                                                      FontSize="{StaticResource SmallTextFontSize}"
                                                      IsVisible="{Binding Schedule, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                      Text="{Binding Schedule}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ReminderTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <materialIcons:MaterialIcon Width="14" Height="14" VerticalAlignment="Center" Kind="ClockOutline" />
                                                <TextBlock FontSize="{StaticResource SmallTextFontSize}" VerticalAlignment="Center" Text="{Binding ReminderTime}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                              Grid.Column="2"
                                              VerticalAlignment="Center"
                                              Orientation="Horizontal"
                                              Spacing="6">
                                        <Button
                                                  Padding="8,4"
                                                  Command="{Binding $parent[ContentPage].((vm:MedicationManagementViewModel)DataContext).RequestEditMedicationCommand}"
                                                  CommandParameter="{Binding}"
                                                  CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Width="14" Height="14" VerticalAlignment="Center" Kind="Pencil" />
                                                <TextBlock VerticalAlignment="Center" Text="Edit" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                                  Padding="8,4"
                                                  Command="{Binding $parent[ContentPage].((vm:MedicationManagementViewModel)DataContext).DeleteMedicationCommand}"
                                                  CommandParameter="{Binding}"
                                                  CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Width="14" Height="14" VerticalAlignment="Center" Kind="DeleteOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="Delete" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid
                      Grid.Row="2"
                      Margin="0,16,0,0"
                      ColumnDefinitions="*,Auto">
                <Button
                          Grid.Column="0"
                          Padding="14,8"
                          Command="{Binding RequestAddMedicationCommand}"
                          CornerRadius="6"
                          FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center" Kind="Plus" />
                        <TextBlock VerticalAlignment="Center" Text="Add New Medication" />
                    </StackPanel>
                </Button>
                <Button
                          Grid.Column="1"
                          Padding="16,8"
                          Command="{Binding CloseCommand}"
                          CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Width="16" Height="16" VerticalAlignment="Center" Kind="Check" />
                        <TextBlock VerticalAlignment="Center" Text="Done" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</ContentPage>
